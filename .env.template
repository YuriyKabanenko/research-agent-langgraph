# Copy to .env and fill in. Never commit the real .env.

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-assistant

# Tavily web search, used by the search_in_web tool
TAVILY_API_KEY=

# App connection string used by the server/Alembic (must match APP_DB_USER/APP_DB_PASSWORD below
# and the host port docker-compose.yml maps Postgres to)
DATABASE_URL=postgresql+asyncpg://<APP_DB_USER>:<APP_DB_PASSWORD>@127.0.0.1:5433/<POSTGRES_DB>

# Postgres superuser, used to bootstrap the db container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=research_assistant

# Non-superuser role the app actually connects as, created by docker-init/init-app-role.sh
APP_DB_USER=research_assistant_app
APP_DB_PASSWORD=

# Symmetric key encrypting AgentConfig.api_token at rest (server/crypto.py). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes existing stored tokens undecryptable - back it up somewhere
# safe, don't just keep it in .env.
ENCRYPTION_KEY=
